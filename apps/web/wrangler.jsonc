{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calebroseland-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "calebroseland.com", "custom_domain": true }],
  // Required for Previews to get a URL.
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_ORIGIN": "https://calebroseland.com",
    "ALLOWED_ORIGINS": "https://calebroseland.com,https://calebroseland.dev"
  },
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "SITE_ORIGIN": "",
      "ALLOWED_ORIGINS": ""
    }
  }
}
