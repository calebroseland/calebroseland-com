[
  {
    "name": "site shell (initial JS, gzip)",
    "path": ["apps/web/dist/client/assets/index-*.js", "apps/web/dist/client/assets/react-*.js"],
    "limit": "125 kB",
    "gzip": true
  },
  {
    "name": "landing route chunk (gzip)",
    "path": [
      "apps/web/dist/client/assets/_card-*.js",
      "apps/web/dist/client/assets/Landing.module-*.js"
    ],
    "limit": "15 kB",
    "gzip": true
  },
  {
    "name": "site CSS (gzip)",
    "path": ["apps/web/dist/client/assets/*.css"],
    "limit": "30 kB",
    "gzip": true
  },
  {
    "name": "entry editor chunk (gzip)",
    "path": ["apps/web/dist/client/assets/editor._slug-*.js"],
    "limit": "600 kB",
    "gzip": true
  }
]
