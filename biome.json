{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/dist",
      "!**/coverage",
      "!**/.wrangler",
      "!**/worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn",
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/routes/editor*.tsx",
        "apps/web/src/routes/login*.tsx",
        "apps/web/src/editor/**",
        "apps/web/src/components/Article.tsx",
        "apps/web/src/components/Page.tsx",
        "apps/web/src/components/SiteFooter.tsx",
        "apps/web/src/components/UserMenu.tsx",
        "apps/web/src/components/CommandPalette*.tsx",
        "apps/web/src/components/SearchButton.tsx"
      ],
      "plugins": ["./tools/biome/no-direct-hooks.grit"]
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
